local function FindFinishline()
    local targetPos = nil
    pcall(function()
        local map = Workspace:FindFirstChild("Map")
        if not map then return nil end

        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local name = tostring(obj.Name):lower()
                if name:find("finish") or name == "finishline" or name == "fininshline" then
                    if obj:IsA("BasePart") then
                        targetPos = obj.Position
                        return
                    elseif obj:IsA("Model") and obj.PrimaryPart then
                        targetPos = obj.PrimaryPart.Position
                        return
                    end
                end
            end
        end

        if map:FindFirstChild("Rooftop") or map:FindFirstChild("RooftopHitbox") then
            targetPos = Vector3.new(1546.12, 152.21, -796.72)
            return
        end
        if map:FindFirstChild("churchbell") then
            targetPos = Vector3.new(760.98, -20.14, -78.48)
            return
        end
        if map:FindFirstChild("HooksMeat") then
            targetPos = Vector3.new(-947.9, 152.12, -7579.52)
            return
        end

        local finishPart = map:FindFirstChild("FinishLine") or map:FindFirstChild("Finishline")
        if finishPart and finishPart:IsA("BasePart") then
            targetPos = finishPart.Position
            return
        end

        targetPos = Vector3.new(3098.16, 454.04, -4918.74)
    end)
    return targetPos
end

local function GetPlayerRole()
    local role = "Survivor"
    pcall(function()
        if LocalPlayer.Team then
            local tName = tostring(LocalPlayer.Team.Name):lower()
            if tName:find("killer") then role = "Killer" return end
            if tName:find("survivor") then role = "Survivor" return end
            if tName:find("spectator") then role = "Spectator" return end
        end
        local char = LocalPlayer.Character
        if char then
            local tag = char:FindFirstChild("Team") or char:FindFirstChild("Role")
            if tag then
                local val = tostring(tag.Value or tag.Name):lower()
                if val:find("killer") then role = "Killer" return end
                if val:find("survivor") then role = "Survivor" return end
                if val:find("spectator") then role = "Spectator" return end
            end
        end
    end)
    return role
end

local function IsIntermissionOrLobby()
    local rs = game:GetService("ReplicatedStorage")
    local checkNames = {"Status", "State", "GameState", "RoundStatus", "GameStatus", "Timer", "RoundTime", "Intermission", "Round", "Match", "GameValues"}
    for _, name in ipairs(checkNames) do
        local obj = rs:FindFirstChild(name, true)
        if obj and (obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("NumberValue")) then
            local valStr = tostring(obj.Value):lower()
            if valStr:find("intermission") or valStr:find("waiting") or valStr:find("starting") or valStr:find("lobby") or valStr:find("prepare") then
                return true, tostring(obj.Value)
            end
        end
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        for _, desc in ipairs(pGui:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Visible then
                local txt = tostring(desc.Text or ""):lower()
                if (txt:find("intermission") or txt:find("starting in") or txt:find("starts in") or txt:find("game start") or txt:find("round start") or txt:find("waiting for")) then
                    return true, desc.Text
                end
            end
        end
    end

    local lobby = Workspace:FindFirstChild("Lobby") or Workspace:FindFirstChild("SpawnLocation")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if lobby and hrp then
        local lobbyPos = lobby:IsA("BasePart") and lobby.Position or (lobby:FindFirstChildWhichIsA("BasePart") and lobby:FindFirstChildWhichIsA("BasePart").Position)
        if lobbyPos and (hrp.Position - lobbyPos).Magnitude < 130 then
            return true, "Masih di Lobby"
        end
    end

    return false, "In Match"
end

