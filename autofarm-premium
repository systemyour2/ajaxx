-- [5] SERVER HOP BLACKLIST ENGINE
-- =========================================================================
local HOP_BLACKLIST_FILE = "ServerHop.txt"
local BLACKLIST_EXPIRE_SECONDS = 600

local function readBlacklistedServers()
    local blacklisted = {}
    local currentTime = os.time()

    if isfile and isfile(HOP_BLACKLIST_FILE) then
        local success, content = pcall(function()
            return readfile(HOP_BLACKLIST_FILE)
        end)
        if success and content then
            for line in string.gmatch(content, "[^\r\n]+") do
                local serverId, addedTimeStr = string.match(line, "^([^|]+)|(%d+)$")
                if serverId and addedTimeStr then
                    local addedTime = tonumber(addedTimeStr) or 0
                    if (currentTime - addedTime) < BLACKLIST_EXPIRE_SECONDS then
                        blacklisted[serverId] = addedTime
                    end
                end
            end
        end
    end
    return blacklisted
end

local function addServerToBlacklist(serverId)
    if not writefile then return end
    local blacklisted = readBlacklistedServers()
    blacklisted[serverId] = os.time()

    local lines = {}
    for id, timeVal in pairs(blacklisted) do
        table.insert(lines, id .. "|" .. tostring(timeVal))
    end
    pcall(function()
        writefile(HOP_BLACKLIST_FILE, table.concat(lines, "\n"))
    end)
end

