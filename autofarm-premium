            CachedStats.Level = currentLevel
            CachedStats.EXP = currentEXP
            CachedStats.Screws = currentScrews
            CachedStats.Gears = currentGears
            CachedStats.SIN = currentSIN
            saveCachedAttributes(CachedStats)

            httpRequest({
                Url = Config.WebhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(embedData)
            })
        end)
    end)
