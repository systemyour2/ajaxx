SendWebhookNotification = function(customTitle, isTest)
    if not isTest and not Config.EnableWebhook then return end
    if not Config.WebhookURL or Config.WebhookURL == "" or not string.find(Config.WebhookURL, "discord.com/api/webhooks") then
        if isTest then
            Notify("GanKunZ", "Webhook URL tidak valid!", 3)
        end
        return
    end

    safeSpawn(function()
        pcall(function()
            if not httpRequest then return end

            local currentAttributes = LocalPlayer:GetAttributes() or {}
            local currentLevel = tonumber(currentAttributes.Level) or CachedStats.Level or 0
            local currentEXP = tonumber(currentAttributes.EXP) or CachedStats.EXP or 0
            local currentScrews = tonumber(currentAttributes.Screws) or CachedStats.Screws or 0
            local currentGears = tonumber(currentAttributes.Gears) or CachedStats.Gears or 0
            local currentSIN = tonumber(currentAttributes.SIN) or CachedStats.SIN or 0

            local expDiff = currentEXP - (CachedStats.EXP or currentEXP)
            local screwsDiff = currentScrews - (CachedStats.Screws or currentScrews)
            local gearsDiff = currentGears - (CachedStats.Gears or currentGears)

            local embedData = {
                ["embeds"] = {{
                    ["title"] = customTitle or "🏆 Ronde Berhasil Selesai!",
                    ["color"] = isTest and 0x38bdf8 or 0xa855f7,
                    ["fields"] = {
                        { ["name"] = "Pemain", ["value"] = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")", ["inline"] = true },
                        { ["name"] = "Level", ["value"] = tostring(currentLevel), ["inline"] = true },
                        { ["name"] = "Role", ["value"] = LastRole or "Survivor", ["inline"] = true },
                        { ["name"] = "💀 SIN", ["value"] = tostring(currentSIN), ["inline"] = true },
                        { ["name"] = "🧪 EXP", ["value"] = string.format("%d (**%+d**)", currentEXP, expDiff), ["inline"] = true },
                        { ["name"] = "🔩 Screws", ["value"] = string.format("%d (**%+d**)", currentScrews, screwsDiff), ["inline"] = true },
                        { ["name"] = "⚙️ Gears", ["value"] = string.format("%d (**%+d**)", currentGears, gearsDiff), ["inline"] = true },
                        { ["name"] = "🆔 Server ID", ["value"] = "```\n" .. tostring(CurrentJobId ~= "" and CurrentJobId or "Singleplayer") .. "\n```", ["inline"] = false }
                    },
                    ["footer"] = { ["text"] = "GanKunZ · Violence District Auto-Farm (" .. getExecutorName() .. ")" },
                    ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
                }}
