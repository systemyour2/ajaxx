-- [10] SERVER HOPPING SYSTEM
-- =========================================================================
ServerHop = function()
    if isHopping then return end
    isHopping = true
    Notify("GanKunZ", "📡 Mencari server 1-3 player...", 3)

    if Config.AutoExecuteOnHop then
        safeQueueOnTeleport(SCRIPT_LOADSTRING)
    end

    local blacklisted = readBlacklistedServers()
    local cursor = ""
    local maxTries = 8
    local currentTry = 0
    local minP = Config.MinPlayers or 1
    local maxP = Config.MaxPlayers or 3
    local fallbackServer = nil

    while currentTry < maxTries do
        currentTry = currentTry + 1
        local apiUrl = string.format(
            "https://games.roblox.com/v1/games/%s/servers/Public?limit=100&sortOrder=Asc&excludeFullGames=true&cursor=%s",
            tostring(PlaceId),
            HttpService:UrlEncode(cursor)
        )
        local success, res = pcall(function()
            return game:HttpGet(apiUrl)
        end)
        if success and res and #res > 0 then
            local data
            pcall(function()
                data = HttpService:JSONDecode(res)
            end)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    if server.id ~= CurrentJobId and not blacklisted[server.id] then
                        local playersCount = server.playing or 0
                        local maxAllowed = server.maxPlayers or 10
                        if playersCount < maxAllowed then
                            if playersCount >= minP and playersCount <= maxP then
                                addServerToBlacklist(server.id)
                                Notify("GanKunZ", string.format("📡 Teleport ke server: %d player", playersCount), 3)
                                local tpSuccess = pcall(function()
                                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                                end)
                                if not tpSuccess then
                                    addServerToBlacklist(server.id)
                                else
                                    safeWait(5)
                                    return
                                end
                            elseif not fallbackServer and playersCount < (maxAllowed - 1) then
                                fallbackServer = server
                            end
                        end
                    end
                end
                if data.nextPageCursor and data.nextPageCursor ~= "" then
                    cursor = data.nextPageCursor
                else
                    break
                end
            end
        end
        safeWait(1)
    end

    if fallbackServer then
        Notify("GanKunZ", string.format("📡 Teleport ke server cadangan: %d player", fallbackServer.playing or 0), 3)
        addServerToBlacklist(fallbackServer.id)
        local tpSuccess = pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, fallbackServer.id, LocalPlayer)
        end)
        if tpSuccess then
            safeWait(5)
            return
        end
    end

    Notify("GanKunZ", "⚠️ Server target penuh, mencoba server acak...", 3)
    pcall(function()
        TeleportService:Teleport(PlaceId, LocalPlayer)
    end)
    safeWait(4)
    isHopping = false
end

